{
  "name": "ledgerlens",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "tsx scripts/configure-bucket-cors.ts && npm run seed:production && next build",
    "seed:production": "[ \"$VERCEL_ENV\" != production ] || tsx scripts/seed-demo.ts || echo \"[seed] Demo seed failed; deploying anyway.\"",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "seed:demo": "tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@aws-sdk/client-s3": "^3.1157.0",
    "@aws-sdk/s3-request-presigner": "^3.1157.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@vercel/oidc-aws-credentials-provider": "^3.3.16",
    "better-auth": "^1.7.14",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
