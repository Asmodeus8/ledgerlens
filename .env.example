# Postgres from docker-compose.yml
DATABASE_URL="postgresql://ledgerlens:ledgerlens@localhost:5433/ledgerlens"
# https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=""
# Without an API key, uploads get sample data instead of a real extraction.
# Set to "claude" or "demo" to force one.
EXTRACTION_MODE=""
# openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
# Object storage. Local: S3Mock from docker-compose.yml.
# Cloudflare R2: S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com", S3_FORCE_PATH_STYLE="false"
S3_ENDPOINT="http://localhost:9090"
S3_REGION="auto"
S3_BUCKET="ledgerlens"
S3_ACCESS_KEY_ID="dev"
S3_SECRET_ACCESS_KEY="dev"
S3_FORCE_PATH_STYLE="true"
